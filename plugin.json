{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "komari",
  "version": "1.1.0",
  "description": "Komari 原生 HTTP API 的独立 MCP 连接器，可查询节点、监控记录和维护到期日、流量配额。",
  "author": {
    "name": "LastDreamTeam"
  },
  "repository": "https://github.com/LastDreamTeam/LDAI_KomariMCP",
  "homepage": "https://github.com/LastDreamTeam/LDAI_KomariMCP",
  "license": "AGPL-3.0-only",
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Komari 监控",
        "shortDescription": "查询监控数据和维护服务器资产",
        "longDescription": "Komari 原生 HTTP API 的独立 MCP 连接器，可查询节点、监控记录和维护到期日、流量配额。",
        "developerName": "LastDreamTeam",
        "category": "Data & Analytics",
        "logo": "./assets/icon.svg",
        "composerIcon": "./assets/icon.svg",
        "defaultPrompt": [
          "查看主机状态和到期时间"
        ]
      },
      "requires_local_executor": true
    }
  }
}
